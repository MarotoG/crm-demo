# Referencia académica local y material auxiliar
/materiales_sintetizados_vscode/
/ZZZIGNORAR/

# documentacion/: solo se publican los documentos del producto.
# Guías y prompts del tutor, síntesis del máster, borrador y contexto
# del servidor (14) se quedan en local.
/documentacion/*
!/documentacion/04_ESTADO_CRM.md
!/documentacion/07_MATRIZ_CUMPLIMIENTO_TFM.md
!/documentacion/10_ESPECIFICACIONES_CRM_CLINICAS.md
!/documentacion/11_BACKLOG_ATOMICO_CRM.md
# Histórico narrativo por fases: solo local (ya cubierto por la regla anterior;
# explícito para que no se publique aunque cambie la lista blanca).
/documentacion/historico/

# Secretos locales (las plantillas sin valores reales sí se versionan)
.env
.env.*
!.env.example
!**/.env.example

