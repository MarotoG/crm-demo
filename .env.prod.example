# Plantilla del .env de publicación (compose.prod.yaml). Copiar a .env en el servidor y sustituir.
# Este archivo se versiona y nunca debe contener valores reales. Permisos del .env: chmod 600.
# Valores aleatorios, por ejemplo: openssl rand -base64 48 | tr -d '/+=\n'

# Dueño de la BD: solo lo usan las migraciones.
CRM_DB_NAME=crm_demo
CRM_DB_USER=crm_owner
CRM_DB_PASSWORD=

# Usuario limitado con el que se conecta la API.
CRM_APP_DB_USER=crm_app
CRM_APP_DB_PASSWORD=

# Clave de los tokens CSRF: al menos 32 caracteres.
CRM_SECRET_KEY=

CRM_CLINIC_TIMEZONE=America/New_York

# Carpeta del servidor para la BD: ruta absoluta, en un sistema de archivos de Linux.
CRM_DB_DATA_DIR=

# Procesos de la API. El límite de login se cuenta por proceso: con 1 es exacto.
CRM_API_WORKERS=1

# Token del túnel propio, del panel de Cloudflare.
CRM_TUNNEL_TOKEN=

# Contraseñas de las cuentas de demo, una por rol; mínimo 12 caracteres.
CRM_DEMO_PASSWORD_ADMIN=
CRM_DEMO_PASSWORD_RECEPTION=
CRM_DEMO_PASSWORD_PROFESSIONAL=
CRM_DEMO_PASSWORD_CLIENT=
