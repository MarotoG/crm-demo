# Plantilla de configuración de crm-demo. Copiar a .env y sustituir los valores.
# .env no se versiona; este archivo sí, y nunca debe contener valores reales.
# Las variables se confirmarán al implementar T04 (API) y T05 (PostgreSQL).

# Entorno: development | production
CRM_ENV=development

# PostgreSQL (Docker Compose y la API leen el mismo .env)
# 127.0.0.1 y no localhost: el puerto solo se publica en IPv4.
CRM_DB_HOST=127.0.0.1
CRM_DB_PORT=5432
CRM_DB_NAME=crm_demo
CRM_DB_USER=crm_demo
CRM_DB_PASSWORD=cambiar-por-una-contrasena-local

# Clave para calcular los tokens CSRF (T09). Obligatoria para el login: al menos 32
# caracteres y distinta de este valor de ejemplo. Generar una propia, por ejemplo:
#   py -3.13 -c "import secrets; print(secrets.token_urlsafe(48))"
CRM_SECRET_KEY=cambiar-por-una-clave-aleatoria

# Zona horaria de la clínica (IANA)
CRM_CLINIC_TIMEZONE=America/New_York

# Contraseñas de las cuentas de demo (T07), una por rol; mínimo 12 caracteres.
# Ficticias y solo para la demo: no reutilizar contraseñas personales ni las de la BD.
# Se aplican con: cd backend; .venv\Scripts\python.exe -m app.seed_demo
CRM_DEMO_PASSWORD_ADMIN=
CRM_DEMO_PASSWORD_RECEPTION=
CRM_DEMO_PASSWORD_PROFESSIONAL=
CRM_DEMO_PASSWORD_CLIENT=
