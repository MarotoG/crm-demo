{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "plain": { "format": "%(asctime)s %(levelname)s %(name)s: %(message)s" }
  },
  "handlers": {
    "stdout": { "class": "logging.StreamHandler", "stream": "ext://sys.stdout", "formatter": "plain" }
  },
  "root": { "level": "WARNING", "handlers": ["stdout"] },
  "loggers": {
    "app": { "level": "INFO" },
    "uvicorn": { "level": "INFO" }
  }
}
